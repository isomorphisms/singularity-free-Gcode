%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 200 100
%%Title: Straight train track A
%%Creator: singularity-free-Gcode
%%Pages: 1
%%EndComments

/line {
  /y2 exch def
  /x2 exch def
  /y1 exch def
  /x1 exch def
  newpath
  x1 y1 moveto
  x2 y2 lineto
  stroke
} bind def

/straightTrack {
  gsave
  1 setlinecap
  2 setlinewidth

  % @source track.A.rail.left
  20 60 180 60 line

  % @source track.A.rail.right
  20 40 180 40 line

  % @source track.A.sleeper.01
  25 35 25 65 line

  % @source track.A.sleeper.02
  45 35 45 65 line

  % @source track.A.sleeper.03
  65 35 65 65 line

  % @source track.A.sleeper.04
  85 35 85 65 line

  % @source track.A.sleeper.05
  105 35 105 65 line

  % @source track.A.sleeper.06
  125 35 125 65 line

  % @source track.A.sleeper.07
  145 35 145 65 line

  % @source track.A.sleeper.08
  165 35 165 65 line

  grestore
} bind def

% @object track.A
straightTrack

showpage
%%EOF
