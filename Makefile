CC = cc
CPPFLAGS += -Iinclude
CFLAGS ?= -O2 -g
CFLAGS += -std=c11 -Wall -Wextra -Wpedantic -Werror
LDLIBS += -lm
CORE = machines/input.c kinematics/forward.c kinematics/inverse.c configuration-space/constraints.c planning/planner.c planning/evidence.c postprocessors/linuxcnc.c

.PHONY: all test examples sanitize clean
all: build/gcode-plan build/check build/examples build/fibers

build:
	mkdir -p build

build/gcode-plan: $(CORE) postprocessors/main.c include/gcode_planner.h | build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(CORE) postprocessors/main.c $(LDFLAGS) $(LDLIBS) -o $@

build/check: $(CORE) tests/check.c include/gcode_planner.h | build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(CORE) tests/check.c $(LDFLAGS) $(LDLIBS) -o $@

build/examples: $(CORE) examples/autogenerated/cnc-evidence/cnc-evidence.c include/gcode_planner.h | build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(CORE) examples/autogenerated/cnc-evidence/cnc-evidence.c $(LDFLAGS) $(LDLIBS) -o $@

build/fibers: algebraic-geometry/fibers.c | build
	$(CC) $(CFLAGS) algebraic-geometry/fibers.c $(LDFLAGS) $(LDLIBS) -o $@

test: build/check build/gcode-plan build/fibers
	./build/check
	./build/fibers

examples: build/examples build/fibers
	./build/examples
	./build/fibers algebraic-geometry/results.tsv

sanitize:
	$(MAKE) clean
	$(MAKE) test CFLAGS='-O1 -g -std=c11 -Wall -Wextra -Wpedantic -Werror -fsanitize=address,undefined -fno-omit-frame-pointer' LDFLAGS='-fsanitize=address,undefined'

clean:
	rm -rf build
